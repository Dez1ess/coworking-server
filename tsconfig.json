{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "Node16",      
    "target": "ES2020",
    "moduleResolution": "Node16", 
    "lib": ["ESNext"],
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],

    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}